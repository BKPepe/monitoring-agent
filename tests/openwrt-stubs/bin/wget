#!/bin/sh
# Canned HiLink modem (192.168.8.1) API. The last argument is the URL; every
# call is logged so the test can prove the SIM/operator answers are cached,
# with "tok " in front when the session cookie rode along.
# BK_STUB_HILINK_MODE picks the modem:
#   canonical  (the default) every GET answers
#   token      E3372h-320 style: 125002 without a session, 125003 with one it
#              never handed out; /api/webserver/SesTokInfo hands one out
#   login      100003 (login required) on every endpoint, session or not
#   noplmn     /api/net/current-plmn answers an error (100002), the rest data
#   cut        status, pin and current-plmn break off before </response> (a
#              connection dropped mid-answer), every value read still whole;
#              device/signal answers whole
#   dead       nothing at all (exit 1, no body): a hung or rebooting modem
for last; do :; done
url="$last"
ses="SessionID=stub-ses-0001"; tok="stub-tok-0001"
case " $* " in
    *" Cookie: $ses "*" __RequestVerificationToken: $tok "*) sent=good ;;
    *" Cookie: "*) sent=other ;;
    *) sent="" ;;
esac
echo "${sent:+tok }$url" >> /work/out/hilink_calls.log
err() { printf '<?xml version="1.0" encoding="UTF-8"?><error><code>%s</code><message></message></error>\n' "$1"; exit 0; }
mode="${BK_STUB_HILINK_MODE:-canonical}"
case "$mode" in
  dead) exit 1 ;;
  token|login)
    case "$url" in
      */api/webserver/SesTokInfo)
        printf '<?xml version="1.0" encoding="UTF-8"?><response><SesInfo>%s</SesInfo><TokInfo>%s</TokInfo></response>\n' "$ses" "$tok"
        exit 0 ;;
    esac
    [ "$mode" = login ] && err 100003
    case "$sent" in good) ;; other) err 125003 ;; *) err 125002 ;; esac ;;
  cut)
    case "$url" in
      */api/monitoring/status) printf '<response><ConnectionStatus>901</ConnectionStatus><SimStatus>1</SimStatus><ServiceStatus>2</ServiceStatus><CurrentNetw'; exit 0 ;;
      */api/pin/status) printf '<response><SimState>257</SimState><SimPinTimes>3</SimPinTimes><SimPu'; exit 0 ;;
      */api/net/current-plmn) printf '<response><FullName>T-Mobile CZ</FullName><ShortNa'; exit 0 ;;
    esac ;;
esac
case "$url" in
  */api/monitoring/status) printf '<response><ConnectionStatus>901</ConnectionStatus><SimStatus>1</SimStatus><ServiceStatus>2</ServiceStatus><CurrentNetworkType>19</CurrentNetworkType></response>\n' ;;
  */api/pin/status) printf '<response><SimState>257</SimState><SimPinTimes>3</SimPinTimes></response>\n' ;;
  */api/device/signal) printf '<response><rsrp>-85dBm</rsrp><rsrq>-9dB</rsrq><sinr>7dB</sinr><rssi>-61dBm</rssi><band>20</band><plmn>23001</plmn><dlbandwidth>20MHz</dlbandwidth><pci>123</pci><cell_id>1234567</cell_id></response>\n' ;;
  */api/net/current-plmn)
    [ "$mode" = noplmn ] && err 100002
    printf '<response><FullName>T-Mobile CZ</FullName><ShortName>T-Mobile</ShortName></response>\n' ;;
  *) exit 1 ;;
esac
